{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "opencode": {
      "whitelist": []
    },
    "deepseek": {
      "blacklist": ["deepseek-chat", "deepseek-reasoner"]
    },
    "kimi-for-coding": {
      "blacklist": ["k3-256k", "kimi-for-coding", "kimi-for-coding-highspeed"]
    },
    "zai-coding-plan": {
      "blacklist": ["glm-5-turbo", "glm-5.2-highspeed", "glm-4.7"]
    }
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ]
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "context-mode",
    "oh-my-openagent@latest",
    "cc-safety-net",
    "@dietrichgebert/ponytail"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  }
}
